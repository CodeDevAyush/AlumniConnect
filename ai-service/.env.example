# ==============================================================================
# ALUMNICONNECT AI/ML SERVICE - ENVIRONMENT VARIABLES
# ==============================================================================

# [MANDATORY] Environment & Server Configuration
ENVIRONMENT=development
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_RELOAD=true
AI_SERVICE_LOG_LEVEL=info

# [MANDATORY] Internal Security API Key
# Must match backend's INTERNAL_API_SECRET_KEY
INTERNAL_API_SECRET_KEY=dev_internal_shared_secret_between_backend_and_ai_service_32b

# [MANDATORY] Allowed CORS Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4000

# [OPTIONAL] Redis Connection (for caching embeddings / results)
REDIS_URL=redis://localhost:6379/0

# [OPTIONAL] External AI & LLM Provider API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# [OPTIONAL] GitHub API Token (for rate-limit free repository evaluation)
GITHUB_PERSONAL_ACCESS_TOKEN=

# [OPTIONAL] Pretrained Model Weights Path
MODEL_CACHE_DIR=./app/models/weights
