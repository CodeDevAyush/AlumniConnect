# ==============================================================================
# ALUMNICONNECT FRONTEND - ENVIRONMENT VARIABLES
# ==============================================================================

# [MANDATORY] NestJS Backend REST API Endpoint (Accessible from client browser)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# [MANDATORY] WebSocket Endpoint for real-time messaging
NEXT_PUBLIC_WS_URL=http://localhost:4000

# [OPTIONAL] Application Branding Metadata
NEXT_PUBLIC_APP_NAME="AlumniConnect"
NEXT_PUBLIC_APP_TAGLINE="Your Campus Network, Activated."
