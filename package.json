{
  "name": "alumniconnect-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AlumniConnect - Your Campus Network, Activated.",
  "scripts": {
    "dev:docker": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "dev:infra": "docker-compose up -d postgres redis",
    "stop:infra": "docker-compose stop postgres redis",
    "down": "docker-compose down -v",
    "lint": "npm run lint:frontend && npm run lint:backend && npm run lint:ai",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:backend": "npm --prefix backend run lint",
    "lint:ai": "ruff check ai-service",
    "format": "npm run format:frontend && npm run format:backend && npm run format:ai",
    "format:frontend": "npm --prefix frontend run format",
    "format:backend": "npm --prefix backend run format",
    "format:ai": "ruff format ai-service",
    "test": "npm run test:backend && npm run test:frontend && npm run test:ai",
    "test:backend": "npm --prefix backend run test",
    "test:frontend": "npm --prefix frontend run test",
    "test:ai": "pytest ai-service/tests",
    "db:migrate": "npm --prefix backend run prisma:migrate",
    "db:seed": "npm --prefix backend run prisma:seed",
    "db:studio": "npm --prefix backend run prisma:studio"
  },
  "keywords": [
    "alumni",
    "mentorship",
    "networking",
    "nestjs",
    "nextjs",
    "fastapi",
    "prisma",
    "postgresql"
  ],
  "author": "AlumniConnect Engineering Team",
  "license": "UNLICENSED"
}
