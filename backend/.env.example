# ==============================================================================
# ALUMNICONNECT BACKEND - ENVIRONMENT VARIABLES
# ==============================================================================

# [MANDATORY] Environment and Port
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# [MANDATORY] Database Connection URL
# Local connection string for PostgreSQL
DATABASE_URL=postgresql://alumni_admin:alumni_secure_password_dev@localhost:5432/alumniconnect_db?schema=public

# [MANDATORY] Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# [MANDATORY] JWT Secrets (Minimum 32 characters in production)
JWT_ACCESS_SECRET=dev_jwt_access_secret_change_in_production_min_32_bytes_long
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production_min_32_bytes_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# [MANDATORY] Internal Communication Secret (NestJS -> FastAPI)
INTERNAL_API_SECRET_KEY=dev_internal_shared_secret_between_backend_and_ai_service_32b

# [MANDATORY] AI Service Endpoint
AI_SERVICE_URL=http://localhost:8000

# [MANDATORY] CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# [OPTIONAL] Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# [OPTIONAL] Mailer Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@alumniconnect.edu
