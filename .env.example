# ==============================================================================
# ALUMNICONNECT - MASTER ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to each service directory or use for local docker-compose:
#   frontend/.env.local
#   backend/.env
#   ai-service/.env
#
# Rule: Never commit production credentials, secret keys, or passwords.
# [MANDATORY] = Required for service to boot
# [OPTIONAL]  = Has defaults or enables optional integrations
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SHARED & GENERAL SETTINGS
# ------------------------------------------------------------------------------
# [MANDATORY] Environment mode: development | staging | production
NODE_ENV=development
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. DATABASE & CACHE (PostgreSQL & Redis)
# ------------------------------------------------------------------------------
# [MANDATORY] PostgreSQL Connection String for Prisma and NestJS
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL=postgresql://alumni_admin:alumni_secure_password_dev@localhost:5432/alumniconnect_db?schema=public

# Docker compose internal database URL (used when services run in docker)
DOCKER_DATABASE_URL=postgresql://alumni_admin:alumni_secure_password_dev@postgres:5432/alumniconnect_db?schema=public

# Database service credentials (used by postgres container)
POSTGRES_USER=alumni_admin
POSTGRES_PASSWORD=alumni_secure_password_dev
POSTGRES_DB=alumniconnect_db
POSTGRES_PORT=5432

# [MANDATORY] Redis Configuration for caching, sessions, and pub/sub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# Docker compose internal Redis URL
DOCKER_REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# 3. BACKEND SERVICE (NestJS)
# ------------------------------------------------------------------------------
# [MANDATORY] Backend Server Port
BACKEND_PORT=4000
PORT=4000
API_PREFIX=api/v1

# [MANDATORY] JWT Authentication Secrets (Generate with `openssl rand -hex 32`)
JWT_ACCESS_SECRET=dev_jwt_access_secret_change_in_production_min_32_bytes_long
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production_min_32_bytes_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# [MANDATORY] Internal Communication Secret (NestJS <-> FastAPI)
# Must match INTERNAL_API_SECRET_KEY in ai-service
INTERNAL_API_SECRET_KEY=dev_internal_shared_secret_between_backend_and_ai_service_32b

# [MANDATORY] URL of the AI/ML Service
AI_SERVICE_URL=http://localhost:8000
DOCKER_AI_SERVICE_URL=http://ai-service:8000

# [MANDATORY] Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# [OPTIONAL] File Storage (Local disk or S3/Cloudflare R2)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
S3_REGION=us-east-1
S3_BUCKET=alumniconnect-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# [OPTIONAL] Email Provider (SMTP / Resend / SendGrid)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@alumniconnect.edu

# ------------------------------------------------------------------------------
# 4. AI/ML SERVICE (Python FastAPI)
# ------------------------------------------------------------------------------
# [MANDATORY] AI Service Port & Host
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_RELOAD=true
AI_SERVICE_LOG_LEVEL=info

# [MANDATORY] Internal Security API Key (Checked on all internal routes)
# Must match backend's INTERNAL_API_SECRET_KEY
INTERNAL_API_SECRET_KEY=dev_internal_shared_secret_between_backend_and_ai_service_32b

# [OPTIONAL] External AI Provider Keys (for advanced LLM/embeddings)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# [OPTIONAL] GitHub Integration (for portfolio & repo evaluation)
GITHUB_PERSONAL_ACCESS_TOKEN=

# [OPTIONAL] Pretrained Model Path or Cache
MODEL_CACHE_DIR=./app/models/weights

# ------------------------------------------------------------------------------
# 5. FRONTEND APPLICATION (Next.js)
# ------------------------------------------------------------------------------
# [MANDATORY] Frontend Port
FRONTEND_PORT=3000

# [MANDATORY] Public Backend API URL (Accessible from user's browser)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000

# [OPTIONAL] Public Application Name & Metadata
NEXT_PUBLIC_APP_NAME="AlumniConnect"
NEXT_PUBLIC_APP_DESCRIPTION="Your Campus Network, Activated."
